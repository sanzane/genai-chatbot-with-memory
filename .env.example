# Copy this file to .env and fill in your actual API key.
# Never commit your real .env file to version control.

# Required: your Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=your_api_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=50
GEMINI_REQUEST_TIMEOUT=60.0
GEMINI_MAX_RETRIES=3
GEMINI_SYSTEM_PROMPT=You are a helpful, friendly AI assistant. Maintain awareness of the full conversation and naturally reference information the user has already shared when it is relevant.
